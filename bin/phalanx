#!/usr/bin/env bash
set -uo pipefail

# Resolve the symlink chain, so installing this as ~/.local/bin/phalanx still
# finds lib/ next to the real script rather than next to the link.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(cd "$(dirname "$self")" && pwd)/$link" ;;
  esac
done
PHALANX_ROOT="$(cd "$(dirname "$self")/.." && pwd)"
export PHALANX_ROOT

PHALANX_VERSION=0.1.0

. "$PHALANX_ROOT/lib/git.sh"
. "$PHALANX_ROOT/lib/agents.sh"
. "$PHALANX_ROOT/lib/session.sh"
. "$PHALANX_ROOT/lib/cleanup.sh"
. "$PHALANX_ROOT/lib/ui.sh"

usage() {
  cat <<'EOF'
phalanx — tmux session manager for coding agents

  phalanx [pick]              agent dashboard (fzf)
  phalanx new [path] [layout] session for a directory
  phalanx work <branch> [layout]
                              worktree + session for a branch
  phalanx bare <branch>       same, with a layout that runs no agent, for
                              whatever you would rather do on the branch yourself
  phalanx rm <branch>         drop the session and its worktree, keeping the branch
  phalanx archive <branch>    stash what is uncommitted, then drop it the same way
  phalanx archived            what has been archived in this repo
  phalanx restore <branch>    bring back a worktree, and its stash if there is one
  phalanx prune               drop worktrees of branches already merged
  phalanx ls [-c] [--tsv]     list sessions, -c narrow, --tsv machine readable
  phalanx --version           print the version

env: PHALANX_HOME (default ~/.phalanx), PHALANX_ROOTS (default ~/repos)
EOF
}

for tool in tmux jq fzf git; do
  command -v "$tool" >/dev/null || { printf 'phalanx: %s is required\n' "$tool" >&2; exit 1; }
done

command="${1:-pick}"
[ $# -gt 0 ] && shift

PHALANX_TSV=""
while [ $# -gt 0 ]; do
  case "$1" in
    -c|--compact) PHALANX_COMPACT=1; export PHALANX_COMPACT; shift ;;
    --tsv)        PHALANX_TSV=1; shift ;;
    *)            break ;;
  esac
done

case "$command" in
  pick)            phalanx_require_tty || exit 1; phalanx_pick "$@" ;;
  new)             phalanx_new "$@" ;;
  work)            if [ $# -gt 0 ]; then phalanx_work "$1" "${2:-}" "$PWD"
                   else phalanx_require_tty || exit 1; phalanx_work_interactive; fi ;;
  bare)            if [ $# -gt 0 ]; then phalanx_bare "$1" "$PWD"
                   else phalanx_require_tty || exit 1; phalanx_bare_interactive; fi ;;
  rm)              phalanx_rm "$@" ;;
  archive)         phalanx_archive "$@" ;;
  archived)        phalanx_archived ;;
  restore)         phalanx_restore "$@" ;;
  prune)           phalanx_prune ;;
  ls)              if [ -n "$PHALANX_TSV" ]; then phalanx_rows; else phalanx_list; fi ;;
  -v|--version)    printf '%s\n' "$PHALANX_VERSION" ;;
  -h|--help|help)  usage ;;
  *)               usage >&2; exit 1 ;;
esac
