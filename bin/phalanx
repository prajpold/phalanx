#!/usr/bin/env bash
set -uo pipefail

# Resolve the symlink chain, so installing this as ~/.local/bin/phalanx still
# finds lib/ next to the real script rather than next to the link.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(cd "$(dirname "$self")" && pwd)/$link" ;;
  esac
done
PHALANX_ROOT="$(cd "$(dirname "$self")/.." && pwd)"
export PHALANX_ROOT

PHALANX_VERSION=0.1.0

. "$PHALANX_ROOT/lib/git.sh"
. "$PHALANX_ROOT/lib/agents.sh"
. "$PHALANX_ROOT/lib/session.sh"
. "$PHALANX_ROOT/lib/ui.sh"

usage() {
  cat <<'EOF'
phalanx — tmux session manager for coding agents

  phalanx [pick]              agent dashboard (fzf)
  phalanx new [path] [layout] session for a directory
  phalanx work <branch>       worktree + session for a branch
  phalanx ops <branch>        terminal-only session for merges and rebases
  phalanx ls [-c] [--tsv]     list sessions, -c narrow, --tsv machine readable
  phalanx --version           print the version

env: PHALANX_HOME (default ~/.phalanx), PHALANX_ROOTS (default ~/repos)
EOF
}

for tool in tmux jq fzf git; do
  command -v "$tool" >/dev/null || { printf 'phalanx: %s is required\n' "$tool" >&2; exit 1; }
done

command="${1:-pick}"
[ $# -gt 0 ] && shift

PHALANX_TSV=""
while [ $# -gt 0 ]; do
  case "$1" in
    -c|--compact) PHALANX_COMPACT=1; export PHALANX_COMPACT; shift ;;
    --tsv)        PHALANX_TSV=1; shift ;;
    *)            break ;;
  esac
done

case "$command" in
  pick)            phalanx_require_tty || exit 1; phalanx_pick "$@" ;;
  new)             phalanx_new "$@" ;;
  work)            if [ $# -gt 0 ]; then phalanx_work "$@"
                   else phalanx_require_tty || exit 1; phalanx_work_interactive; fi ;;
  ops)             if [ $# -gt 0 ]; then phalanx_ops "$@"
                   else phalanx_require_tty || exit 1; phalanx_ops_interactive; fi ;;
  ls)              if [ -n "$PHALANX_TSV" ]; then phalanx_rows; else phalanx_list; fi ;;
  -v|--version)    printf '%s\n' "$PHALANX_VERSION" ;;
  -h|--help|help)  usage ;;
  *)               usage >&2; exit 1 ;;
esac
