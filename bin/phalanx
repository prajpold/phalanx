#!/usr/bin/env bash
set -uo pipefail

# Resolve the symlink chain, so installing this as ~/.local/bin/phalanx still
# finds lib/ next to the real script rather than next to the link.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(cd "$(dirname "$self")" && pwd)/$link" ;;
  esac
done
PHALANX_ROOT="$(cd "$(dirname "$self")/.." && pwd)"
export PHALANX_ROOT

PHALANX_VERSION=0.2.0

. "$PHALANX_ROOT/lib/git.sh"
. "$PHALANX_ROOT/lib/agents.sh"
. "$PHALANX_ROOT/lib/session.sh"
. "$PHALANX_ROOT/lib/cleanup.sh"
. "$PHALANX_ROOT/lib/ui.sh"

usage() {
  cat <<'EOF'
phalanx — tmux session manager for coding agents

  phalanx [pick]              agent dashboard (fzf)
  phalanx new [name]          session in this repo's checkout
      --worktree [worktree]   run it in a worktree of its own, named after the
                              session unless you name one; a worktree is not a
                              branch and outlives any branch checked out in it
      --branch <branch>       which branch that worktree starts on, a new one
                              named after the worktree by default
      --layout <layout>       which windows to open
  phalanx rm <worktree>       drop a worktree and any session running in it
  phalanx archive <worktree>  stash what is uncommitted, then drop it
  phalanx archived            what has been archived in this repo
  phalanx restore <worktree>  bring a worktree back, and its stash if any
  phalanx prune               drop worktrees whose session is gone
  phalanx ls [-c] [--tsv]     list sessions, -c narrow, --tsv machine readable
  phalanx --version           print the version

env: PHALANX_HOME (default ~/.phalanx), PHALANX_ROOTS (default ~/repos)
EOF
}

for tool in tmux jq fzf git; do
  command -v "$tool" >/dev/null || { printf 'phalanx: %s is required\n' "$tool" >&2; exit 1; }
done

command="${1:-pick}"
[ $# -gt 0 ] && shift

PHALANX_TSV=""
while [ $# -gt 0 ]; do
  case "$1" in
    -c|--compact) PHALANX_COMPACT=1; export PHALANX_COMPACT; shift ;;
    --tsv)        PHALANX_TSV=1; shift ;;
    *)            break ;;
  esac
done

case "$command" in
  pick)
    phalanx_require_tty || exit 1
    phalanx_pick
    ;;
  new)
    name=""; worktree=""; worktree_name=""; branch=""; layout=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --worktree)
          worktree=1; shift
          case "${1:-}" in ''|-*) ;; *) worktree_name="$1"; shift ;; esac
          ;;
        --branch)
          [ $# -ge 2 ] || { printf 'phalanx: --branch needs a name\n' >&2; exit 1; }
          branch="$2"; shift 2
          ;;
        --layout)
          [ $# -ge 2 ] || { printf 'phalanx: --layout needs a name\n' >&2; exit 1; }
          layout="$2"; shift 2
          ;;
        -*) usage >&2; exit 1 ;;
        *)
          [ -z "$name" ] || { usage >&2; exit 1; }
          name="$1"; shift
          ;;
      esac
    done
    if [ -n "$name" ]; then
      [ -n "$worktree" ] && worktree="${worktree_name:-$name}"
      phalanx_session "$name" "$worktree" "$branch" "$layout" "$PWD"
    else
      phalanx_require_tty || exit 1
      if [ -n "$worktree" ]; then phalanx_worktree_interactive; else phalanx_main_interactive; fi
    fi
    ;;
  rm)              phalanx_rm "$@" ;;
  archive)         phalanx_archive "$@" ;;
  archived)        phalanx_archived ;;
  restore)         phalanx_restore "$@" ;;
  prune)           phalanx_prune ;;
  ls)              if [ -n "$PHALANX_TSV" ]; then phalanx_rows; else phalanx_list; fi ;;
  -v|--version)    printf '%s\n' "$PHALANX_VERSION" ;;
  -h|--help|help)  usage ;;
  *)               usage >&2; exit 1 ;;
esac
