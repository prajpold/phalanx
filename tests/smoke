#!/usr/bin/env bash
# Checks the seams a shell script has no compiler for: that the dispatcher only
# calls functions that exist, that awk and fzf accept what the code builds, and
# that the listings still come out in the shape the popup parses.
set -uo pipefail

PHALANX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PHALANX_ROOT
failed=0

check() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'ok    %s\n' "$label"
  else
    printf 'FAIL  %s\n' "$label"
    failed=$((failed + 1))
  fi
}

for file in "$PHALANX_ROOT"/lib/*.sh "$PHALANX_ROOT/bin/phalanx" "$PHALANX_ROOT/phalanx.tmux"; do
  check "parses: ${file#$PHALANX_ROOT/}" bash -n "$file"
done
check 'parses: lib/rows.awk' awk -f "$PHALANX_ROOT/lib/rows.awk" /dev/null

. "$PHALANX_ROOT/lib/git.sh"
. "$PHALANX_ROOT/lib/agents.sh"
. "$PHALANX_ROOT/lib/session.sh"
. "$PHALANX_ROOT/lib/cleanup.sh"
. "$PHALANX_ROOT/lib/ui.sh"

for name in $(grep -o '\b_\{0,1\}phalanx_[a-z_]*' "$PHALANX_ROOT/bin/phalanx" | sort -u); do
  check "dispatcher calls a real function: $name" test "$(type -t "$name")" = function
done

for layout in "$PHALANX_ROOT"/layouts/*; do
  check "layout is non-empty: ${layout#$PHALANX_ROOT/}" test -s "$layout"
done
check 'the default layout runs an agent' _phalanx_layout_has_agent "$PHALANX_ROOT/layouts/default"

check 'removal never forces' test -z "$(grep -rn 'worktree remove.*--force' "$PHALANX_ROOT/lib")"
check 'removal never deletes a branch' test -z "$(grep -rn 'branch -[dD]' "$PHALANX_ROOT/lib")"

check 'version' "$PHALANX_ROOT/bin/phalanx" --version
check 'help' "$PHALANX_ROOT/bin/phalanx" --help
check 'ls' "$PHALANX_ROOT/bin/phalanx" ls
check 'ls -c' "$PHALANX_ROOT/bin/phalanx" ls -c
check 'ls --tsv' "$PHALANX_ROOT/bin/phalanx" ls --tsv

fields="$("$PHALANX_ROOT/bin/phalanx" ls --tsv | awk -F'\t' 'NR == 1 { print NF }')"
check "ls --tsv keeps 9 fields (got ${fields:-none})" test "${fields:-0}" -eq 9

check 'fzf accepts the dashboard options' env sh -c '
  printf a\\n | fzf --filter=a --ansi --highlight-line --no-scrollbar \
    --layout=reverse --pointer=x --marker=x --footer-border=line \
    --color="$1"' _ "$(_phalanx_colors)"

printf '\n%s\n' "$([ "$failed" -eq 0 ] && echo 'all good' || echo "$failed failed")"
exit "$failed"
